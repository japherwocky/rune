# Copy this file to %APPDATA%\rune\.env (Windows) or ~/.config/rune/.env (Unix)
# and fill in your actual values. This file is checked into git as documentation;
# the actual .env in your config directory is .gitignored.

# OpenCode Zen API key for LLM requests
# Get it from https://opencode.ai/
OPENCODE_API_KEY=your-key-here

# --- Local / self-hosted LLM (llama.cpp, or any other OpenAI-compatible
# server - Ollama, vLLM, LM Studio, ...) instead of OpenCode Zen ---
# Uncomment RUNE_LLM_PROVIDER to switch. Leave both commented to use Zen.

# RUNE_LLM_PROVIDER=openai

# Full endpoint URL, required when RUNE_LLM_PROVIDER=openai - there's no
# safe default to guess (the port varies by setup). For llama.cpp's
# llama-server run with default settings, this is typically:
# RUNE_LLM_URL=http://localhost:8080/v1/chat/completions

# Optional - llama.cpp needs no key by default. Set this only if your
# server was started with an --api-key (or you're pointing at a remote
# OpenAI-compatible host that requires one).
# RUNE_LLM_API_KEY=your-key-here
